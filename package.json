{
  "name": "form-gym-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate:postgres": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:migrate:auth": "tsx scripts/migrate-users-to-supabase-auth.ts",
    "db:migrate:phase3": "tsx scripts/migrate-phase3.ts",
    "db:migrate:phase4": "tsx scripts/migrate-phase4.ts",
    "db:migrate:phase5": "tsx scripts/migrate-phase5.ts",
    "db:migrate:phase6": "tsx scripts/migrate-phase6.ts",
    "db:migrate:phase8": "tsx scripts/migrate-phase8.ts",
    "db:migrate:phase9": "tsx scripts/migrate-phase9.ts",
    "test": "node --env-file=.env --import tsx --test tests/**/*.test.ts",
    "e2e:db": "tsx scripts/setup-e2e-db.ts",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "start:e2e": "next start -p 3100"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "latest",
    "date-fns": "latest",
    "drizzle-orm": "latest",
    "jose": "latest",
    "lucide-react": "latest",
    "next": "16.3.1",
    "postgres": "3.4.7",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.3.1",
    "tsx": "latest",
    "typescript": "latest"
  }
}
